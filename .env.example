# Local/base config loaded by src/config.py (via python-dotenv). Keys match the Settings field names
# (no prefix). In prod, .env.prod overrides these; real env vars override both.

ENV=local

# (No REPO_ROOT: multi-project -- the codebase root is supplied per session via register_project, not
# global config. Each indexed repo carries a `.codeindex.config.js` with its canonical project slug.)

# Code resolver backend for spread, behind the swappable Resolver seam (src/services/spread/lsp.py).
# "multilspy" (default) = multilspy-managed jedi-language-server for Python (pip-only, no Node). "jedi" and
# "pyright" are accepted aliases and currently map to the same multilspy backend (this multilspy build only
# ships jedi for Python; a dedicated pyright client would be an added branch + lsp file).
RESOLVER_BACKEND=multilspy

# Mongo persistence for the index entities.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=code_index2

# Semantic search.
VOYAGE_API_KEY=
FAISS_INDEX_DIR=./data/indexes

# Query-view inlining (repo-frontier). The claude CLI binary and model for `claude -p`.
CLAUDE_BIN=claude
CLAUDE_QUERY_VIEW_MODEL=claude-haiku-4-5-20251001

# MCP servers. Separate tokens per server (exact-match auth), distributed by hand.
READ_MCP_PORT=8210
ADMIN_MCP_PORT=8211
READ_MCP_TOKEN=
ADMIN_MCP_TOKEN=

# Public host(s) the MCP servers accept in the Host header (behind a reverse proxy). Comma-separated.
MCP_ALLOWED_HOSTS=
