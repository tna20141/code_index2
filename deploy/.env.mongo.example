# Mongo container credentials (for docker-compose.mongo.yml). Copy to `.env.mongo` and fill with REAL
# values on the VPS. `.env.mongo` is gitignored -- never commit real credentials.

MONGO_ROOT_USER=codeindex
# generate a strong one, e.g.:  openssl rand -hex 24
MONGO_ROOT_PASSWORD=CHANGE_ME

# The app then connects with (put this in the app's .env.prod as MONGO_URI):
#   MONGO_URI=mongodb://codeindex:<the-password>@localhost:27017/?authSource=admin
