# Prod config for the code_index2 MCP servers (loaded by src/config.py when ENV=prod, which the pm2
# ecosystem sets). Copy to `.env.prod` on the VPS and fill REAL values. `.env.prod` is gitignored.

ENV=prod

# Mongo (the containerized DB from deploy/docker-compose.mongo.yml -- has auth). Credentials must match
# .env.mongo's MONGO_ROOT_USER/PASSWORD.
MONGO_URI=mongodb://codeindex:CHANGE_ME@localhost:27017/?authSource=admin
MONGO_DB=code_index2

# Resolver (jedi via multilspy -- pip only, already in .venv). Leave as-is.
RESOLVER_BACKEND=multilspy

# Semantic search embeddings. Required for `search` / `rebuild_search_index`.
VOYAGE_API_KEY=CHANGE_ME
FAISS_INDEX_DIR=./data/indexes

# Query-view inlining (repo-frontier). The `claude` CLI must be installed + authenticated on the VPS.
CLAUDE_BIN=claude
CLAUDE_QUERY_VIEW_MODEL=claude-haiku-4-5-20251001

# MCP servers -- bound to 127.0.0.1 by the ecosystem; nginx proxies. Use STRONG random tokens
# (openssl rand -hex 32), distributed by hand. Separate token per server so read/admin are gated apart.
READ_MCP_PORT=8210
ADMIN_MCP_PORT=8211
READ_MCP_TOKEN=CHANGE_ME
ADMIN_MCP_TOKEN=CHANGE_ME
